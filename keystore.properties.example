# Chép file này thành keystore.properties (đã được .gitignore bỏ qua) và điền thông tin khoá ký của bạn.
# Tạo khoá mới: keytool -genkeypair -v -keystore zenvid-release.jks -alias zenvid -keyalg RSA -keysize 4096 -validity 10000
storeFile=zenvid-release.jks
storePassword=
keyAlias=zenvid
keyPassword=
